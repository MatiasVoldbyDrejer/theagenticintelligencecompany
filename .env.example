# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.

# --- Required for the access-request form ---------------------------------
# Without this the form returns 502 and the request is lost. Create a key at
# https://resend.com/api-keys with send permission.
RESEND_API_KEY=

# --- Required to persist the request -------------------------------------
# The request row, and its acceptance record, are written by an intake route in
# the yap-room app - this site holds no database credentials of its own. The
# form rejects a submission it cannot record, so both of these must be set.
# The secret is shared with DATA_ACCESS_INTAKE_SECRET on that side and signs the
# request body; generate one with `openssl rand -hex 32`.
DATA_ACCESS_INTAKE_URL=
DATA_ACCESS_INTAKE_SECRET=

# --- Optional -------------------------------------------------------------
# Where access requests are delivered. Defaults to matias@theagenticdatacompany.com.
DATASET_ACCESS_NOTIFY_EMAIL=

# Sender address on the notification. Its domain must be verified in Resend or
# the send is rejected. Defaults to requests@theagenticdatacompany.com.
DATASET_ACCESS_FROM_EMAIL=

# --- Tooling only, never read by the site ---------------------------------
# Checkout holding the built @yaproom/domain package, read by
# scripts/generate-snapshot.mjs to pull the delivery schema and archive tree.
# Defaults to /Users/mvd/Projects/yap-room.
YAPROOM_ROOT=
