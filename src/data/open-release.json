{
  "name": "Open Corpus 1K",
  "tagline": "One thousand hours of unscripted two-person conversation, each speaker on a separate uncompressed 48 kHz track.",
  "description": "Real people talking to each other, recorded from two locations at once. Each side is captured locally as uncompressed PCM at the microphone’s native rate and never passed through the call codec, so the delivered audio carries the full bandwidth and dynamics of the original capture rather than what survived transmission. Both tracks share one timeline and one sample count, which makes the corpus usable for turn-taking, overlap, and full-duplex work that mixed-down recordings cannot support.",
  "license": {
    "name": "Placeholder Data Use Agreement v0",
    "summary": "Free for commercial and research use under a signed data use agreement. No redistribution, no re-identification, deletion on notice."
  },
